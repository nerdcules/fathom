#!/usr/bin/python3 -I
"""Fathom Sentinel's firewall buttons. Installed root-owned to
/usr/local/lib/fathom-sentinel/admin and run through pkexec, so it takes
only these exact commands and checks every argument.

  admin lockdown on|off   block (or stop blocking) every new incoming
                          connection on Wi-Fi and wired networks
  admin block <ip>        block an address
  admin unblock <ip>
  admin remove-all        take out every rule Fathom added (uninstall)

A rule is Fathom's only if it has Fathom's comment (fathom-lockdown or
fathom-block) and exactly the shape these buttons add. Every other rule is
yours and is never removed or changed, even one that differs from Fathom's
only by its comment. Rules are removed by their full description, comment
included, which ufw 0.36.2 matches exactly; rule numbers are never used.
The rule files are read again before each removal and compared after it,
so anything ufw removed or added that wasn't Fathom's is reported.
"""

import ipaddress
import json
import os
import re
import subprocess
import sys
from collections import Counter

# Tests point these at a scratch folder and stand-in commands; pkexec
# clears the environment, so in use they are always /etc and /usr/bin.
ETC = os.environ.get("FATHOM_SENTINEL_ETC", "/etc")
PATH = os.environ.get("FATHOM_SENTINEL_PATH", "/usr/bin")
RULES = {4: os.path.join(ETC, "ufw/user.rules"), 6: os.path.join(ETC, "ufw/user6.rules")}
DEFAULTS = os.path.join(ETC, "default/ufw")
LOCKDOWN_TAG = "fathom-lockdown"
BLOCK_TAG = "fathom-block"
ANY = {4: "0.0.0.0/0", 6: "::/0"}
# Wi-Fi, wired and mobile interfaces; not loopback, Docker or VPN.
OUTSIDE = re.compile(r"^(wl|en|eth|ww)[A-Za-z0-9]{0,13}$")
SEE = "See every rule with: sudo ufw status numbered"


def die(msg, code=2):
    print(f"fathom-sentinel admin: {msg}", file=sys.stderr)
    sys.exit(code)


def note(msg):
    print(f"fathom-sentinel admin: {msg}", file=sys.stderr)


class Rule:
    """One '### tuple ###' line of ufw's user.rules or user6.rules:
    action proto dport dst sport src [dapp sapp] direction[_iface] [comment=<hex>]"""

    def __init__(self, family, line):
        self.family = family
        self.line = line
        body = line[len("### tuple ###"):].strip()
        self.comment = ""
        if " comment=" in body:
            body, _, hexed = body.partition(" comment=")
            try:
                self.comment = bytes.fromhex(hexed.strip()).decode("utf-8")
            except ValueError:
                self.comment = "\0unreadable"
        self.fields = body.split()

    def plain(self):
        """Any protocol, any ports, not a route rule: the shape Fathom adds."""
        f = self.fields
        return len(f) == 7 and f[1] == "any" and f[2] == "any" and f[4] == "any" and ":" not in f[0]

    def lockdown_iface(self):
        """The interface, if this is 'in on <iface>' from anywhere to anywhere."""
        f = self.fields
        if (self.plain() and f[3] == ANY[self.family] and f[5] == ANY[self.family]
                and f[6].startswith("in_") and "!" not in f[6]):
            return f[6][3:]
        return None

    def block_source(self):
        """The address, if this is 'from <one address>' to anywhere."""
        f = self.fields
        if not (self.plain() and f[3] == ANY[self.family] and f[6] == "in"):
            return None
        try:
            net = ipaddress.ip_network(f[5], strict=False)
        except ValueError:
            return None
        if net.num_addresses != 1:
            return None
        return net.network_address

    def fathoms(self, tag):
        return self.comment == tag and self.fields[0] == "deny"

    def key(self):
        return (self.family, self.line)


def ipv6_on():
    try:
        with open(DEFAULTS, encoding="utf-8") as f:
            return any(line.strip() == "IPV6=yes" for line in f)
    except OSError:
        return False


def read_rules():
    """Every rule ufw itself reads: user6.rules only when IPv6 is on."""
    rules = []
    for family in (4, 6) if ipv6_on() else (4,):
        try:
            with open(RULES[family], encoding="utf-8") as f:
                rules += [Rule(family, line.rstrip("\n")) for line in f if line.startswith("### tuple ###")]
        except FileNotFoundError:
            pass
    return rules


def ufw(*args):
    r = subprocess.run(["ufw", *args], capture_output=True, text=True)
    if r.returncode != 0:
        die(f"ufw {' '.join(args)} failed: {(r.stderr or r.stdout).strip()}", 1)
    return (r.stdout + r.stderr).strip()


def describe(rule):
    if not rule.plain():
        return rule.line
    f = rule.fields
    where = f"in on {f[6][3:]}" if f[6].startswith("in_") else f"from {f[5]}"
    action = f[0].replace("_", " ")
    comment = f" (comment '{rule.comment}')" if rule.comment else ""
    return f"{action} {where}{comment}"


def change(args, expect_added, expect_removed, what):
    """Run ufw with args and check that the rule files changed in exactly the
    expected way: only rules for which expect_added / expect_removed say yes
    appeared or went, and at least one did."""
    before = Counter(r.key() for r in read_rules())
    out = ufw(*args)
    after_rules = read_rules()
    after = Counter(r.key() for r in after_rules)
    by_key = {r.key(): r for r in after_rules}
    added = after - before
    removed = before - after
    wrong_add = [k for k in added if not expect_added(by_key[k])]
    wrong_del = [k for k in removed if not expect_removed(Rule(*k))]
    if wrong_add or wrong_del:
        lines = [f"  added:   {Rule(*k).line}" for k in wrong_add] + [f"  removed: {Rule(*k).line}" for k in wrong_del]
        die(f"ufw changed rules that aren't Fathom's while {what}:\n" + "\n".join(lines) +
            "\nPut them back as they were (sudo ufw ...), then tell Fathom's author. " + SEE, 4)
    if not added and not removed:
        die(f"ufw changed nothing while {what}" + (f" (it said: {out})" if out else "") + f". {SEE}", 4)


# ---------------------------------------------------------------- lockdown

def outside_ifaces():
    r = subprocess.run(["ip", "-j", "link"], capture_output=True, text=True)
    if r.returncode != 0:
        die("couldn't list the network interfaces", 1)
    names = [link.get("ifname", "") for link in json.loads(r.stdout or "[]")]
    return [n for n in names if OUTSIDE.match(n)]


def lockdown_on():
    families = {4, 6} if ipv6_on() else {4}
    rules = read_rules()
    todo, clashes = [], []
    for iface in outside_ifaces():
        same = [r for r in rules if r.lockdown_iface() == iface]
        theirs = [r for r in same if not r.fathoms(LOCKDOWN_TAG)]
        if theirs:
            clashes += theirs
        elif not families <= {r.family for r in same}:
            todo.append(iface)
    if clashes:
        # ufw won't add a rule that matches one of these except for its
        # action or comment, and Fathom won't take over yours.
        die("lockdown is not on: these rules aren't Fathom's but match the ones it would add, so ufw "
            "would skip Fathom's:\n" + "\n".join(f"  {describe(r)}" for r in clashes) +
            "\nDelete or change them yourself (sudo ufw delete <number>), then turn lockdown on again. "
            f"Nothing was changed. {SEE}", 3)
    for iface in todo:
        change(("prepend", "deny", "in", "on", iface, "comment", LOCKDOWN_TAG),
               lambda r, i=iface: r.lockdown_iface() == i and r.fathoms(LOCKDOWN_TAG),
               lambda r: False, f"turning lockdown on for {iface}")


def remove_lockdown(iface):
    for _ in range(64):
        if not any(r.lockdown_iface() == iface and r.fathoms(LOCKDOWN_TAG) for r in read_rules()):
            return
        change(("delete", "deny", "in", "on", iface, "comment", LOCKDOWN_TAG),
               lambda r: False,
               lambda r: r.lockdown_iface() == iface and r.fathoms(LOCKDOWN_TAG),
               f"ending lockdown on {iface}")
    die(f"lockdown rules for {iface} keep coming back. {SEE}", 4)


def lockdown_off():
    rules = read_rules()
    for iface in sorted({r.lockdown_iface() for r in rules if r.fathoms(LOCKDOWN_TAG)} - {None}):
        if OUTSIDE.match(iface):
            remove_lockdown(iface)
    for r in rules:
        iface = r.lockdown_iface()
        if iface and OUTSIDE.match(iface) and not r.fathoms(LOCKDOWN_TAG):
            note(f"kept your own rule '{describe(r)}': Fathom didn't add it")


# ---------------------------------------------------------------- one address

def address(arg):
    try:
        return ipaddress.ip_address(arg)
    except ValueError:
        die(f"'{arg}' is not an IP address")


def block(ip):
    family = ip.version
    if family == 6 and not ipv6_on():
        die(f"{ip} is IPv6 and ufw's IPv6 is off (IPV6=no in /etc/default/ufw); nothing was changed", 3)
    same = [r for r in read_rules() if r.block_source() == ip]
    theirs = [r for r in same if not r.fathoms(BLOCK_TAG)]
    if theirs:
        die(f"{ip} was not blocked by Fathom: these rules aren't Fathom's but match the one it would add, "
            "so ufw would skip Fathom's:\n" + "\n".join(f"  {describe(r)}" for r in theirs) +
            f"\nChange them yourself if you want {ip} blocked (sudo ufw ...). Nothing was changed. {SEE}", 3)
    if same:
        return  # Fathom already blocks it.
    change(("prepend", "deny", "from", str(ip), "comment", BLOCK_TAG),
           lambda r: r.block_source() == ip and r.fathoms(BLOCK_TAG),
           lambda r: False, f"blocking {ip}")


def remove_block(ip):
    for _ in range(64):
        mine = [r for r in read_rules() if r.block_source() == ip and r.fathoms(BLOCK_TAG)]
        if not mine:
            return
        change(("delete", "deny", "from", mine[0].fields[5], "comment", BLOCK_TAG),
               lambda r: False,
               lambda r: r.block_source() == ip and r.fathoms(BLOCK_TAG),
               f"unblocking {ip}")
    die(f"block rules for {ip} keep coming back. {SEE}", 4)


def unblock(ip):
    same = [r for r in read_rules() if r.block_source() == ip]
    if any(r.fathoms(BLOCK_TAG) for r in same):
        remove_block(ip)
    theirs = [r for r in same if not r.fathoms(BLOCK_TAG)]
    if theirs:
        die(f"{ip} is still blocked by rules Fathom didn't add, which it leaves alone:\n" +
            "\n".join(f"  {describe(r)}" for r in theirs) +
            f"\nDelete them yourself to unblock it (sudo ufw delete <number>). {SEE}", 3)


# ---------------------------------------------------------------- uninstall

def remove_all():
    """Every rule with Fathom's comments: the ones in Fathom's shape go, any
    other rule carrying the comment is reported and left."""
    left = []
    rules = read_rules()
    for iface in sorted({r.lockdown_iface() for r in rules if r.fathoms(LOCKDOWN_TAG)} - {None}):
        remove_lockdown(iface)
    for ip in sorted({r.block_source() for r in rules if r.fathoms(BLOCK_TAG)} - {None}, key=str):
        remove_block(ip)
    for r in read_rules():
        if r.comment in (LOCKDOWN_TAG, BLOCK_TAG):
            left.append(r)
    if left:
        die("left these rules: they carry Fathom's comment but not the shape Fathom adds, so they may be "
            "yours:\n" + "\n".join(f"  {describe(r)}" for r in left) +
            f"\nDelete them yourself if they are Fathom's (sudo ufw delete <number>). {SEE}", 3)


def main(argv):
    if os.geteuid() != 0 and "FATHOM_SENTINEL_ETC" not in os.environ:
        die("run as root (through pkexec)")
    os.environ["PATH"] = PATH
    cmd = argv[0] if argv else ""
    if cmd == "lockdown" and len(argv) == 2 and argv[1] in ("on", "off"):
        lockdown_on() if argv[1] == "on" else lockdown_off()
    elif cmd == "lockdown":
        die("lockdown takes on or off")
    elif cmd in ("block", "unblock") and len(argv) == 2:
        ip = address(argv[1])
        block(ip) if cmd == "block" else unblock(ip)
    elif cmd == "remove-all" and len(argv) == 1:
        remove_all()
    else:
        die("takes lockdown on|off, block <ip>, unblock <ip> or remove-all")


if __name__ == "__main__":
    main(sys.argv[1:])
