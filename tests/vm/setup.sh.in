#!/bin/bash
# Run inside the disposable Omarchy test VM, in a terminal there:
#   curl -s http://10.0.2.2:8765/setup.sh | bash
# Lets the host drive Fathom's checks over SSH: passwordless sudo, sshd,
# SSH through Omarchy's firewall, and the host's key for this VM. Only for
# a throwaway VM.
set -e
echo "$USER ALL=(ALL) NOPASSWD: ALL" | sudo tee /etc/sudoers.d/90-fathom-test >/dev/null
sudo chmod 440 /etc/sudoers.d/90-fathom-test
sudo pacman -S --needed --noconfirm openssh >/dev/null
sudo systemctl enable --now sshd
# Omarchy turns ufw on and denies incoming connections; let SSH in.
sudo ufw allow 22/tcp >/dev/null
mkdir -p ~/.ssh && chmod 700 ~/.ssh
echo "@KEY@" >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys
echo "Ready: the host can connect now."
